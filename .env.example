# Google AI Studio Key
GEMINI_API_KEY=
# Modelle. Stand 4.9.2026: gemini-2.5-flash ist für neue Accounts abgeschaltet (404).
# gemini-3.8-flash ist das stärkste Flash-Modell zum selben Preis wie 3.6/3.7, war beim
# Test aber durchgehend mit 503 überlastet — erst umstellen, wenn die Kapazität steht.
# gemini-3.5-flash-lite ist ~5x schneller und ohne Thinking-Tokens deutlich billiger;
# Kandidat für Massenläufe, sobald es gegen echte ETIM-Daten gemessen ist.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# ETIM-Version, wie sie im BMEcat referenziert wird
ETIM_VERSION=ETIM-10.0
# Konfidenzschwelle für Review-Queue
ETIM_REVIEW_THRESHOLD=0.75
# 1 = keine echten API-Calls (Tests)
ETIM_DRY_RUN=0

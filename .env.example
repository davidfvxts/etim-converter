# Google AI Studio Key
GEMINI_API_KEY=
# Modelle. Stand 14.9.2026, Modellliste live gegen die API geprüft.
#   gemini-2.5-flash      für neue Accounts abgeschaltet (404) — nicht mehr verwenden
#   gemini-3.5-flash-lite lief auf dem Free Tier durch, ~0.6s/Call. Bis 14.9.2026 Default.
#   gemini-3.8-flash      neuestes und stärkstes Flash-Modell, gleicher Preis wie 3.6/3.7.
#                         Seit 14.9.2026 Default (Entscheidung David). Auf dem Free Tier
#                         nur 20 Anfragen/Tag — Pipeline-Läufe brauchen aktives Billing.
#   Neuer als Flash ist nur gemini-3.1-pro-preview (Pro, teurer, hier nicht nötig).
# Achtung: die Modellwahl ist gegen 6 Fixture-Klassen gemessen, nicht gegen die echten
# 5.640 ETIM-Klassen. Vor dem ersten Kundenkatalog 3.5-flash-lite gegen 3.8-flash messen.
GEMINI_MODEL=gemini-3.8-flash
# Embeddings: gemini-embedding-2 ist seit 14.9.2026 GA (nicht mehr -preview) und ersetzt
# gemini-embedding-001. Beide liefern 3072 Dimensionen, ein Wechsel ändert also nichts
# am Cache-Format — aber der .npz-Cache muss neu gebaut werden.
GEMINI_EMBED_MODEL=gemini-embedding-2
# ETIM-Version, wie sie im BMEcat referenziert wird
ETIM_VERSION=ETIM-10.0
# Konfidenzschwelle für Review-Queue
ETIM_REVIEW_THRESHOLD=0.75
# Mindestanteil befuellter Merkmale, damit ein Artikel ohne Review exportiert wird.
# Faengt Artikel ab, bei denen das Modell fast nichts aus dem Katalog ziehen konnte —
# die fallen beim Grosshaendler-Datencheck ohnehin durch. 0 schaltet die Pruefung ab.
ETIM_MIN_COVERAGE=0.30
# 1 = keine echten API-Calls (Tests)
ETIM_DRY_RUN=0

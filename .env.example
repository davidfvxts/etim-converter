# Google AI Studio Key
GEMINI_API_KEY=
# Modelle. Stand 4.9.2026, gemessen gegen tests/fixtures/katalog_mini.csv:
#   gemini-2.5-flash      für neue Accounts abgeschaltet (404) — nicht mehr verwenden
#   gemini-3.5-flash-lite Default. Läuft auf dem Free Tier durch, ~0.6s/Call, keine
#                         Thinking-Tokens, günstigster Tarif. Alle Testfälle korrekt.
#   gemini-3.8-flash      stärkstes Flash-Modell zum selben Preis wie 3.6/3.7. Auf dem
#                         Free Tier nur 20 Anfragen/Tag — für Pipeline-Läufe erst
#                         brauchbar, wenn im Google-AI-Studio-Projekt Billing aktiv ist.
# Achtung: die Modellwahl ist gegen 6 Fixture-Klassen gemessen, nicht gegen die echten
# ~5.500 ETIM-Klassen. Vor dem ersten Kundenkatalog beide gegeneinander messen.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# ETIM-Version, wie sie im BMEcat referenziert wird
ETIM_VERSION=ETIM-10.0
# Konfidenzschwelle für Review-Queue
ETIM_REVIEW_THRESHOLD=0.75
# Mindestanteil befuellter Merkmale, damit ein Artikel ohne Review exportiert wird.
# Faengt Artikel ab, bei denen das Modell fast nichts aus dem Katalog ziehen konnte —
# die fallen beim Grosshaendler-Datencheck ohnehin durch. 0 schaltet die Pruefung ab.
ETIM_MIN_COVERAGE=0.30
# 1 = keine echten API-Calls (Tests)
ETIM_DRY_RUN=0
